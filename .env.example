# Supabase (optional — app runs in demo mode without these)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional Phase 2: use Supabase Edge Function for Gemini (server-held key)
# Requires login + deployed gemini-proxy function + GEMINI_API_KEY secret
VITE_GEMINI_PROXY=false

# Display-only: shown in copy; enforced server-side via GEMINI_PROXY_DAILY_LIMIT
VITE_FREE_TIER_PROXY_DAILY=2

# Never put Gemini API keys in VITE_* vars — they would be public in the build.
# Users bring their own key via Settings, unless proxy mode is enabled.
